{
  "version": 2,
  "functions": {
    "api/webhook.js": { "maxDuration": 10 },
    "api/tts.js": { "maxDuration": 10 },
    "api/sync.js": { "maxDuration": 30 },
    "api/push-subscribe.js": { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    { "src": "/api/tts", "dest": "/api/tts.js" },
    { "src": "/api/sync", "dest": "/api/sync.js" },
    { "src": "/api/push-subscribe", "dest": "/api/push-subscribe.js" },
    { "src": "/sw.js", "dest": "/public/sw.js", "headers": { "Service-Worker-Allowed": "/" } },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
